.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Backups
*.backup
*.bak
catering-backup*

# Temp
tmp/
temp/
*.tmp
'@ | Out-File -Encoding utf8 .gitignore
