@'
# Dependencies
node_modules/

# Build output
release/
dist/
build/
out/

# Databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

