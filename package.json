{
  "name": "catering-system",
  "productName": "نظام إدارة الإعاشة",
  "version": "2.1.0",
  "description": "نظام إدارة إعاشة الحج والعمرة - متعدد المستخدمين",
  "main": "main.js",
  "author": "Ibrahim Osama <ibrahimosama505@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist-portable": "electron-builder --win portable",
    "postinstall": "electron-builder install-app-deps",
    "publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "bcryptjs": "2.4.3",
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.catering.system",
    "productName": "نظام إدارة الإعاشة",
    "files": [
      "main.js",
      "preload.js",
      "db/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "publish": [
        {
          "provider": "github",
          "owner": "ibrahimosama505-droid",
          "repo": "catering-system"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "catering-setup-${version}.${ext}"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "ibrahimosama505-droid",
      "repo": "catering-system",
      "releaseType": "release"
    }
  }
}